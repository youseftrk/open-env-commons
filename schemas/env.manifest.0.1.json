{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-real2sim.org/schemas/env.manifest.0.1.json",
  "title": "open-real2sim.env.manifest/0.1",
  "description": "Environment package manifest for open-env-commons v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "name",
    "summary",
    "category",
    "created_at",
    "license",
    "attribution",
    "capture",
    "assets",
    "sim",
    "quality"
  ],
  "properties": {
    "schema": {
      "const": "open-real2sim.env.manifest/0.1"
    },
    "id": {
      "type": "string",
      "pattern": "^env:[A-Za-z0-9._-]+/[A-Za-z0-9._-]+@[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "description": "Default contribution category for v0 is home_indoor",
      "enum": [
        "home_indoor",
        "home_outdoor",
        "office",
        "warehouse",
        "lab",
        "other"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code"
      ],
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "CC-BY-4.0",
            "CC0"
          ]
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "attribution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contributors"
      ],
      "properties": {
        "contributors": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "role"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "role": {
                "type": "string",
                "enum": [
                  "scene_owner",
                  "capture",
                  "reconstruct",
                  "curator",
                  "other"
                ]
              },
              "contact": {
                "type": "string"
              },
              "share": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            }
          }
        },
        "derived_from": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        }
      }
    },
    "capture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "session_id",
        "schema",
        "capture_mode",
        "capture_device_class",
        "package",
        "session_mcap_sha256"
      ],
      "properties": {
        "session_id": {
          "type": "string",
          "minLength": 1
        },
        "schema": {
          "const": "open-real2sim.capture.manifest/0.1"
        },
        "capture_mode": {
          "type": "string",
          "enum": [
            "robot_ros2",
            "android",
            "tablet_android",
            "ios_later"
          ]
        },
        "capture_device_class": {
          "type": "string",
          "enum": [
            "robot_onboard",
            "handheld_phone",
            "handheld_tablet"
          ],
          "description": "Derived from capture_mode via device-class map"
        },
        "package": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "path": {
              "type": [
                "string",
                "null"
              ]
            },
            "uri": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "anyOf": [
            {
              "required": [
                "path"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            {
              "required": [
                "uri"
              ],
              "properties": {
                "uri": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          ]
        },
        "session_mcap_sha256": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$",
          "description": "SHA-256 of session MCAP (hex)"
        },
        "purpose": {
          "type": "string",
          "enum": [
            "scene",
            "calib",
            "other"
          ]
        },
        "duration_s": {
          "type": "number",
          "minimum": 0
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "streams_present": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "rgb",
              "depth",
              "imu",
              "lidar",
              "pose",
              "audio",
              "other"
            ]
          }
        },
        "calibration": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "rig_id": {
              "type": "string"
            },
            "method": {
              "type": "string",
              "enum": [
                "factory",
                "target",
                "self",
                "unknown"
              ]
            }
          }
        }
      }
    },
    "assets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "visual",
        "collision",
        "previews"
      ],
      "properties": {
        "visual": {
          "type": "object",
          "required": [
            "format",
            "path"
          ],
          "properties": {
            "format": {
              "type": "string"
            },
            "path": {
              "type": "string"
            }
          }
        },
        "collision": {
          "type": "object",
          "required": [
            "format",
            "path"
          ],
          "properties": {
            "format": {
              "type": "string"
            },
            "path": {
              "type": "string"
            }
          }
        },
        "semantics": {
          "type": "object",
          "properties": {
            "format": {
              "type": "string"
            },
            "path": {
              "type": "string"
            },
            "optional": {
              "type": "boolean"
            }
          }
        },
        "previews": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "point_cloud_thumb": {
              "type": "string"
            },
            "depth_thumb": {
              "type": "string"
            },
            "photoreal_still": {
              "type": "string"
            }
          }
        }
      }
    },
    "sim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "targets",
        "units",
        "up_axis"
      ],
      "properties": {
        "targets": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": [
              "isaac_lab",
              "mujoco",
              "genesis",
              "other"
            ]
          }
        },
        "units": {
          "const": "meters"
        },
        "up_axis": {
          "type": "string",
          "enum": [
            "z",
            "y"
          ]
        },
        "origin": {
          "type": "string"
        }
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "draft",
            "local_ok",
            "sim_ok",
            "published"
          ]
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "gates_passed": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "G0_schema",
              "G1_preview",
              "G2_collision",
              "G3_sim_smoke",
              "G4_attrib"
            ]
          }
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "rewards_hooks": {
      "type": "object",
      "additionalProperties": false,
      "description": "Optional reputation / bounty hooks only \u2014 deferred for v0 public use",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "scheme": {
          "type": [
            "string",
            "null"
          ]
        },
        "reputation_weight": {
          "type": [
            "number",
            "null"
          ]
        }
      }
    }
  }
}
